\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces {\color  {blue}Ranking stability under confounding perturbation. $f$ is the fraction of the differential NPI effect shrunk toward the cross-policy mean, and $\rho $ is the Spearman rank correlation between the perturbed and baseline cost rankings across all 343 policies. ``First $f$ at which optimal changes'' reports the smallest $f$ for which the cost-minimizing policy differs from baseline. ``$\rho < 0.80$'' reports the smallest $f$ at which $\rho $ drops below $0.80$.}}}{56}{table.caption.102}\protected@file@percent }
\newlabel{tab:ranking_stability}{{16}{56}{\rev {Ranking stability under confounding perturbation. $f$ is the fraction of the differential NPI effect shrunk toward the cross-policy mean, and $\rho $ is the Spearman rank correlation between the perturbed and baseline cost rankings across all 343 policies. ``First $f$ at which optimal changes'' reports the smallest $f$ for which the cost-minimizing policy differs from baseline. ``$\rho < 0.80$'' reports the smallest $f$ at which $\rho $ drops below $0.80$.}}{table.caption.102}{}}
