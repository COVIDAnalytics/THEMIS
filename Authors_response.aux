\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pooled state-action decision tree for optimal THEMIS prescriptions. Internal nodes split on observable state features and on $w$; labeled leaves L1--L13 predict the optimal next-month NPI, color-coded by class. Left branches satisfy the condition (Yes); right branches violate it (No).}}{20}{figure.caption.15}\protected@file@percent }
\newlabel{fig:state_action_pooled_tree}{{3}{20}{Pooled state-action decision tree for optimal THEMIS prescriptions. Internal nodes split on observable state features and on $w$; labeled leaves L1--L13 predict the optimal next-month NPI, color-coded by class. Left branches satisfy the condition (Yes); right branches violate it (No)}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cost-optimal next-month NPI for each (prefix, weight) pair, displayed per region. Rows index policy prefixes (length $0$, $1$, or $2$); columns index the humanitarian weight $w$; cell colour encodes the recommended NPI severity. The smooth left-to-right escalation at fixed prefix is the signature of the weight-conditional optimal-action map; the structure within each panel reflects how past policy and accumulated state determine the next decision. The four panels share the same colourbar.}}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:state_action_grid}{{4}{21}{Cost-optimal next-month NPI for each (prefix, weight) pair, displayed per region. Rows index policy prefixes (length $0$, $1$, or $2$); columns index the humanitarian weight $w$; cell colour encodes the recommended NPI severity. The smooth left-to-right escalation at fixed prefix is the signature of the weight-conditional optimal-action map; the structure within each panel reflects how past policy and accumulated state determine the next decision. The four panels share the same colourbar}{figure.caption.16}{}}
