\@writefile{lot}{\contentsline {table}{\numberline {R.10}{\ignorespaces Distribution of the cost-optimal next-month NPI across $228$ (region, prefix) decision points per row, at five representative humanitarian weights. The tree is trained on a $20$-point weight grid ($4{,}560$ rows); the table shows five evenly spaced slices. The optimum shifts monotonically from $\{1,5\}$ at $w=0$ to $\{6,7\}$ at $w=1$.}}{21}{table.caption.17}\protected@file@percent }
\newlabel{tab:state_action_action_distribution}{{R.10}{21}{Distribution of the cost-optimal next-month NPI across $228$ (region, prefix) decision points per row, at five representative humanitarian weights. The tree is trained on a $20$-point weight grid ($4{,}560$ rows); the table shows five evenly spaced slices. The optimum shifts monotonically from $\{1,5\}$ at $w=0$ to $\{6,7\}$ at $w=1$}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {R.11}{\ignorespaces Five managerially informative leaves of the pooled state-action tree (depth~$4$, minimum leaf size~$20$, $4{,}560$ training points, $20$ weights). None of the conditions references a region indicator. R1 and R3 identify exit regimes where releasing restrictions is optimal despite humanitarian pressure; R2 characterises aggressive intervention when active cases are surging; R4 reveals that even economy-first policymakers should restrict when deaths are rising; R5 prescribes early preemptive lockdown before costs accumulate. Together R1--R5 cover $2{,}554$ of $4{,}560$ points.}}{22}{table.caption.18}\protected@file@percent }
\newlabel{tab:state_action_rules}{{R.11}{22}{Five managerially informative leaves of the pooled state-action tree (depth~$4$, minimum leaf size~$20$, $4{,}560$ training points, $20$ weights). None of the conditions references a region indicator. R1 and R3 identify exit regimes where releasing restrictions is optimal despite humanitarian pressure; R2 characterises aggressive intervention when active cases are surging; R4 reveals that even economy-first policymakers should restrict when deaths are rising; R5 prescribes early preemptive lockdown before costs accumulate. Together R1--R5 cover $2{,}554$ of $4{,}560$ points}{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Pooled state-action decision tree with humanitarian weight $w$ as a feature (depth~$4$, minimum leaf size~$20$, five-fold CV accuracy~$0.47$, $n=4{,}560$). Internal nodes split on eight observable state features and on $w$; leaves predict the optimal next-month NPI (numbered $1$--$7$), colour-coded by class. Left branches satisfy the condition (Yes); right branches violate it (No). All $16$ leaves have at least $20$ training points.}}{22}{figure.caption.19}\protected@file@percent }
\newlabel{fig:state_action_pooled_tree}{{3}{22}{Pooled state-action decision tree with humanitarian weight $w$ as a feature (depth~$4$, minimum leaf size~$20$, five-fold CV accuracy~$0.47$, $n=4{,}560$). Internal nodes split on eight observable state features and on $w$; leaves predict the optimal next-month NPI (numbered $1$--$7$), colour-coded by class. Left branches satisfy the condition (Yes); right branches violate it (No). All $16$ leaves have at least $20$ training points}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Cost-optimal next-month NPI for each (prefix, weight) pair, displayed per region. Rows index policy prefixes (length $0$, $1$, or $2$); columns index the humanitarian weight $w$; cell colour encodes the recommended NPI severity. The smooth left-to-right escalation at fixed prefix is the signature of the weight-conditional optimal-action map; the structure within each panel reflects how past policy and accumulated state determine the next decision. The four panels share the same colourbar.}}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:state_action_grid}{{4}{23}{Cost-optimal next-month NPI for each (prefix, weight) pair, displayed per region. Rows index policy prefixes (length $0$, $1$, or $2$); columns index the humanitarian weight $w$; cell colour encodes the recommended NPI severity. The smooth left-to-right escalation at fixed prefix is the signature of the weight-conditional optimal-action map; the structure within each panel reflects how past policy and accumulated state determine the next decision. The four panels share the same colourbar}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {R.12}{\ignorespaces Online rolling-horizon advisor versus the unattainable hindsight optimum. $\pi ^{\text  {online}}_R$: rolling-horizon advisor with one-step lookahead under online rank-$1$ ALS gammas. $\pi ^{\text  {actual}}_R$: the policy actually implemented; the cost is the real observed cost via \texttt  {policy\_type="actual"}. $\pi ^{\text  {HS}}_R$: hindsight-optimal sequence over all $7^3=343$ enumerations under full-window $\hat  \gamma ^{\text  {full}}$. Costs are expressed as \% of quarterly (3-month) GDP. The gap columns report the percentage difference from the hindsight-optimal cost. Online costs are evaluated under $\hat  \gamma ^{\text  {full}}$ on a single ground truth so the comparison isolates the policy-choice effect.}}{25}{table.caption.21}\protected@file@percent }
\newlabel{tab:rolling_advisor_v2}{{R.12}{25}{Online rolling-horizon advisor versus the unattainable hindsight optimum. $\pi ^{\text {online}}_R$: rolling-horizon advisor with one-step lookahead under online rank-$1$ ALS gammas. $\pi ^{\text {actual}}_R$: the policy actually implemented; the cost is the real observed cost via \texttt {policy\_type="actual"}. $\pi ^{\text {HS}}_R$: hindsight-optimal sequence over all $7^3=343$ enumerations under full-window $\hat \gamma ^{\text {full}}$. Costs are expressed as \% of quarterly (3-month) GDP. The gap columns report the percentage difference from the hindsight-optimal cost. Online costs are evaluated under $\hat \gamma ^{\text {full}}$ on a single ground truth so the comparison isolates the policy-choice effect}{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Three-month total cost for each region (as \% of quarterly GDP) under the online advisor, the actual implemented policy, and the hindsight optimum. Bars decompose total cost into economic (blue) and humanitarian (red) components. NPI sequences below each bar follow the numbering of the main paper.}}{25}{figure.caption.22}\protected@file@percent }
\newlabel{fig:rolling_advisor_v2}{{5}{25}{Three-month total cost for each region (as \% of quarterly GDP) under the online advisor, the actual implemented policy, and the hindsight optimum. Bars decompose total cost into economic (blue) and humanitarian (red) components. NPI sequences below each bar follow the numbering of the main paper}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Weighted cost (\% of quarterly GDP) for each policy evaluated under the region's revealed preference weight~$w^\star _R$. The weight is shown in each panel title. Germany ($w^\star = 0.72$) prioritised humanitarian outcomes; Brazil ($w^\star = 0.01$) prioritised the economy; Spain ($w^\star = 0.45$) was roughly balanced; New York ($w^\star = 0.10$) leaned economic.}}{26}{figure.caption.23}\protected@file@percent }
\newlabel{fig:revealed_preference}{{6}{26}{Weighted cost (\% of quarterly GDP) for each policy evaluated under the region's revealed preference weight~$w^\star _R$. The weight is shown in each panel title. Germany ($w^\star = 0.72$) prioritised humanitarian outcomes; Brazil ($w^\star = 0.01$) prioritised the economy; Spain ($w^\star = 0.45$) was roughly balanced; New York ($w^\star = 0.10$) leaned economic}{figure.caption.23}{}}
