\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scatter plots of imputed $\gamma _{R,i}$ entries: rank-1 vs.\ rank-2 (row~1) and rank-1 vs.\ rank-3 (row~2) across three pandemic periods. High correlation confirms that higher-rank models largely agree with the rank-1 baseline on unobserved policy-region combinations.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:rank1_vs_rank3_scatter}{{1}{6}{Scatter plots of imputed $\gamma _{R,i}$ entries: rank-1 vs.\ rank-2 (row~1) and rank-1 vs.\ rank-3 (row~2) across three pandemic periods. High correlation confirms that higher-rank models largely agree with the rank-1 baseline on unobserved policy-region combinations}{figure.caption.2}{}}
